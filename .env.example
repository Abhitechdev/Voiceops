# ==============================================================================
# VoiceOps Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (SQLite default for MVP, PostgreSQL for production)
DATABASE_URL=sqlite:///./voiceops.db

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=voiceops-dev-secret-key-gnani-ai-challenge-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Gnani AI Speech-to-Text Configuration
# Set GNANI_MOCK_MODE=false once you provide official Gnani credentials
GNANI_MOCK_MODE=true
GNANI_API_KEY=
GNANI_API_ENDPOINT=https://api.gnani.ai/v1/stt
GNANI_LANGUAGE_CODE=te-IN

# Issue Information Extraction Component (FR-04)
# Options: 'rules' (deterministic, zero external API cost), 'gemini', 'openai'
EXTRACTION_ENGINE=rules
GEMINI_API_KEY=
OPENAI_API_KEY=

# Audio Recording Limits
MAX_AUDIO_FILE_SIZE_MB=15
MAX_AUDIO_DURATION_SECONDS=120
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,webm,ogg,m4a
